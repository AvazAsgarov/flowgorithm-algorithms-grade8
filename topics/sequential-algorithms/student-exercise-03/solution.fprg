<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="solution"/>
        <attribute name="authors" value="Informatics Teacher"/>
        <attribute name="about" value="Sadə ədədi orta və çəkili bal"/>
        <attribute name="saved" value="2026-09-20 12:00:00 PM"/>
        <attribute name="created" value="VGVhY2hlcjs7MjAyNi0wOS0yMDs="/>
        <attribute name="edited" value="VGVhY2hlcjs7MjAyNi0wOS0yMDs="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="mathScore, csScore, englishScore, simpleAverage, weightedScore" type="Real" array="False" size=""/>
            <output expression="&quot;Riyaziyyat balını daxil edin:&quot;" newline="True"/>
            <input variable="mathScore"/>
            <output expression="&quot;İnformatika balını daxil edin:&quot;" newline="True"/>
            <input variable="csScore"/>
            <output expression="&quot;İngilis dili balını daxil edin:&quot;" newline="True"/>
            <input variable="englishScore"/>
            <assign variable="simpleAverage" expression="(mathScore + csScore + englishScore) / 3"/>
            <assign variable="weightedScore" expression="(mathScore * 0.40) + (csScore * 0.35) + (englishScore * 0.25)"/>
            <output expression="&quot;Sadə ədədi orta: &quot; &amp; simpleAverage" newline="True"/>
            <output expression="&quot;Çəkili yekun bal: &quot; &amp; weightedScore" newline="True"/>
        </body>
    </function>
</flowgorithm>
