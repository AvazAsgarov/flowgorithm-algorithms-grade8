<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="solution"/>
        <attribute name="authors" value="Informatics Teacher"/>
        <attribute name="about" value="Alış-veriş məbləği və qalıq pul"/>
        <attribute name="saved" value="2026-09-20 12:00:00 PM"/>
        <attribute name="created" value="VGVhY2hlcjs7MjAyNi0wOS0yMDs="/>
        <attribute name="edited" value="VGVhY2hlcjs7MjAyNi0wOS0yMDs="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="price, payment, totalPrice, change" type="Real" array="False" size=""/>
            <declare name="quantity" type="Integer" array="False" size=""/>
            <output expression="&quot;Bir dəftərin qiymətini daxil edin (AZN):&quot;" newline="True"/>
            <input variable="price"/>
            <output expression="&quot;Alınan dəftərlərin sayını daxil edin:&quot;" newline="True"/>
            <input variable="quantity"/>
            <output expression="&quot;Kassirə verilən məbləği daxil edin (AZN):&quot;" newline="True"/>
            <input variable="payment"/>
            <assign variable="totalPrice" expression="price * quantity"/>
            <assign variable="change" expression="payment - totalPrice"/>
            <output expression="&quot;Ümumi məbləğ: &quot; &amp; totalPrice &amp; &quot; AZN&quot;" newline="True"/>
            <output expression="&quot;Qaytarılacaq qalıq: &quot; &amp; change &amp; &quot; AZN&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
