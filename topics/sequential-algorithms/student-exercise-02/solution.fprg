<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="solution"/>
        <attribute name="authors" value="Informatics Teacher"/>
        <attribute name="about" value="Səyahət müddəti və yanacaq sərfi"/>
        <attribute name="saved" value="2026-09-20 12:00:00 PM"/>
        <attribute name="created" value="VGVhY2hlcjs7MjAyNi0wOS0yMDs="/>
        <attribute name="edited" value="VGVhY2hlcjs7MjAyNi0wOS0yMDs="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="distance, speed, consumptionPer100Km, travelTime, totalFuel" type="Real" array="False" size=""/>
            <output expression="&quot;Məsafəni daxil edin (km):&quot;" newline="True"/>
            <input variable="distance"/>
            <output expression="&quot;Orta sürəti daxil edin (km/saat):&quot;" newline="True"/>
            <input variable="speed"/>
            <output expression="&quot;100 km-ə yanacaq sərfiyyatını daxil edin (litr):&quot;" newline="True"/>
            <input variable="consumptionPer100Km"/>
            <assign variable="travelTime" expression="distance / speed"/>
            <assign variable="totalFuel" expression="(distance / 100) * consumptionPer100Km"/>
            <output expression="&quot;Səyahət müddəti: &quot; &amp; travelTime &amp; &quot; saat&quot;" newline="True"/>
            <output expression="&quot;Tələb olunan ümumi yanacaq: &quot; &amp; totalFuel &amp; &quot; litr&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
