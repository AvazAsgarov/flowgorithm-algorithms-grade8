<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="solution"/>
        <attribute name="authors" value="Informatics Teacher"/>
        <attribute name="about" value="Düzbucaqlı otağın sahəsi və perimetri"/>
        <attribute name="saved" value="2026-09-20 12:00:00 PM"/>
        <attribute name="created" value="VGVhY2hlcjs7MjAyNi0wOS0yMDs="/>
        <attribute name="edited" value="VGVhY2hlcjs7MjAyNi0wOS0yMDs="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="length, width, area, perimeter" type="Real" array="False" size=""/>
            <output expression="&quot;Otağın uzunluğunu daxil edin (metr):&quot;" newline="True"/>
            <input variable="length"/>
            <output expression="&quot;Otağın enini daxil edin (metr):&quot;" newline="True"/>
            <input variable="width"/>
            <assign variable="area" expression="length * width"/>
            <assign variable="perimeter" expression="2 * (length + width)"/>
            <output expression="&quot;Otağın sahəsi: &quot; &amp; area &amp; &quot; kv.m&quot;" newline="True"/>
            <output expression="&quot;Otağın perimetri: &quot; &amp; perimeter &amp; &quot; m&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
